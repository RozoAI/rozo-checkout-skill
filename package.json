{
  "name": "@rozoai/checkout",
  "version": "0.1.11",
  "type": "module",
  "description": "Pay OpenRouter, or any Coinbase invoice, with the crypto you already hold: USDT/USDC on Solana, BNB Chain, Ethereum or Polygon, USDC on Base or Stellar, or BTC over Lightning. No Coinbase account.",
  "license": "MIT",
  "author": "Rozo AI",
  "homepage": "https://github.com/RozoAI/rozo-checkout-skill#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RozoAI/rozo-checkout-skill.git"
  },
  "bugs": {
    "url": "https://github.com/RozoAI/rozo-checkout-skill/issues"
  },
  "keywords": [
    "openrouter",
    "openrouter-credits",
    "coinbase",
    "coinbase-payment-link",
    "usdc",
    "usdt",
    "solana",
    "bnb-chain",
    "ethereum",
    "polygon",
    "base",
    "stellar",
    "lightning",
    "bitcoin",
    "crypto-payments",
    "agent",
    "ai-agent",
    "agent-skill",
    "claude-skill",
    "claude-code",
    "payments",
    "cli",
    "mcp-free",
    "x402"
  ],
  "bin": {
    "rozo-checkout": "scripts/dist/cli.js"
  },
  "files": [
    "scripts/dist",
    "docs/*.md",
    "!docs/reviews",
    "llms.txt",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.18.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "npm run build && npm test",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@solana/web3.js": "^1.95.0",
    "esbuild": "^0.28.2",
    "viem": "^2.21.0"
  },
  "overrides": {
    "jayson": {
      "uuid": "^11.1.1"
    }
  }
}
